# --- Database ---
# For local prototyping without Postgres, set DB_PROVIDER=sqlite
# and DATABASE_URL="file:./dev.db"
DB_PROVIDER=postgresql
DATABASE_URL="postgresql://user:password@localhost:5432/cosmic_park?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Booking rules ---
HOLD_DURATION_MINUTES=15
DEFAULT_CURRENCY=INR
DEFAULT_GST_PERCENT=18

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
