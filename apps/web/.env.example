# Base URL of the Cosmic Park booking API.
# Leave BLANK in local dev — vite.config.js proxies /api and /uploads to
# the API (default http://localhost:4000), so the app uses same-origin
# relative URLs. Set this to the full API origin for a deployed build,
# e.g. https://api.cosmicpark.in
VITE_API_BASE_URL=

# Optional: override the dev proxy target if the API isn't on :4000.
# VITE_API_TARGET=http://localhost:4000
